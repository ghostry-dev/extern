{
  "name": "@ghostry/extern",
  "version": "0.0.17",
  "license": "MIT",
  "description": "Mock calls to external systems without changing a signature.",
  "keywords": [
    "dependency injection",
    "mock",
    "spy",
    "test",
    "typescript"
  ],
  "author": {
    "name": "Patrick Rebsch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostry-dev/extern"
  },
  "homepage": "https://docs.ghostry.dev/extern",
  "bugs": "https://github.com/ghostry-dev/extern/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "imports": {
    "#scope": {
      "types": "./src/Scope/Async.ts",
      "node": "./dist/esm/Scope/Async.js",
      "bun": "./dist/esm/Scope/Async.js",
      "default": "./dist/esm/Scope/Sync.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./harnessing": {
      "types": "./dist/types/harnessing.d.ts",
      "import": "./dist/esm/harnessing.js",
      "default": "./dist/esm/harnessing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@ghostry/harness": "^0.0.7"
  },
  "scripts": {
    "build:reset": "rm -rf ./dist",
    "build:compile": "bunx --no-install --bun rslib build --config ./rslib.config.ts",
    "build:compile:rsdoctor": "RSDOCTOR=true bunx --no-install --bun rslib build --config ./rslib.config.ts",
    "build:types": "bun --bun ../../node_modules/typescript-5/lib/tsc.js -p ./tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --declarationDir ./dist/types",
    "build:verify": "tsc --noEmit -p ./tsconfig.verify.json",
    "build:clean": "find ./dist -type f -name '*.tsbuildinfo' -delete",
    "build": "bun run build:reset && bun run build:compile && bun run build:types && bun run build:verify && bun run build:clean",
    "build:rsdoctor": "bun run build:reset && bun run build:compile:rsdoctor && bun run build:types && bun run build:verify && bun run build:clean",
    "typecheck": "tsc --noEmit",
    "typecheck:ts5": "bun --bun ../../node_modules/typescript-5/lib/tsc.js --noEmit",
    "typecheck:jsr": "DENO_BIN_PATH=$PWD/../../node_modules/.bin/deno bunx --no-install jsr publish --dry-run --allow-dirty",
    "format": "bun fmt",
    "test": "bun run typecheck && bun run typecheck:ts5 && bun run typecheck:jsr && bun test"
  },
  "files": [
    "dist"
  ]
}
